set audio.driver pipewire
set midi.driver alsa_seq
set midi.autoconnect True

set synth.midi-channels 16
set synth.default-soundfont /usr/share/soundfonts/FluidR3_GM.sf2

set synth.gain 1.0

set synth.reverb.active False
set synth.chorus.active False

select 0 1 0 0
select 1 1 0 11
select 2 1 0 19
select 3 1 0 22
select 4 1 0 24
select 5 1 0 25
select 6 1 0 30
select 7 1 0 33
select 8 1 0 34
select 9 1 128 0
select 10 1 0 36
select 11 1 0 40
select 12 1 0 42
select 13 1 0 56
select 14 1 0 65
select 15 1 0 73
